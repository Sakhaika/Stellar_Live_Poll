# Isi setelah deploy contract (lihat contracts/poll/README atau root README)
VITE_CONTRACT_ID=

# RPC Soroban Testnet (default sudah benar, biasanya tidak perlu diubah)
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Opsional: address testnet yang sudah funded, dipakai untuk baca hasil poll
# SEBELUM ada wallet yang connect (biar visitor bisa lihat live results tanpa connect dulu).
# Kalau dikosongkan, poll baru ke-load setelah user connect wallet.
VITE_READ_SOURCE_ACCOUNT=
